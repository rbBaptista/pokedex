// Schema do Prisma: define o banco (SQLite em dev) e os modelos de dados.
// Rodar migrações a partir de apps/api (ver scripts db:migrate / db:generate).
// A partir do Prisma 7, a URL de conexão não fica mais aqui: ela é definida
// em apps/api/prisma.config.ts.

datasource db {
  provider = "sqlite"
}

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// Um Pokémon da Pokédex, com seus atributos base.
model Pokemon {
  id                 Int      @id
  nome               String
  altura             Int
  peso               Int
  hpBase             Int
  ataqueBase         Int
  defesaBase         Int
  ataqueEspecialBase Int
  defesaEspecialBase Int
  velocidadeBase     Int
  spriteUrl          String
  geracaoNumero      Int
  criadoEm           DateTime @default(now())

  tipos    PokemonType[]
  geracao  Generation    @relation(fields: [geracaoNumero], references: [numero])
  capturas Captura[]
}

// Uma geração de Pokémon (ex: geração 1 = Kanto).
model Generation {
  numero Int    @id
  regiao String

  pokemons Pokemon[]
}

// Um tipo de Pokémon (fire, water, grass, etc.).
model Type {
  id   Int    @id @default(autoincrement())
  nome String @unique

  pokemons PokemonType[]
}

// Tabela de ligação: um Pokémon pode ter vários tipos, e um tipo pertence a vários Pokémons.
model PokemonType {
  pokemonId Int
  typeId    Int

  pokemon Pokemon @relation(fields: [pokemonId], references: [id])
  tipo    Type    @relation(fields: [typeId], references: [id])

  @@id([pokemonId, typeId])
}

// Um usuário cadastrado no site.
model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  // "USER" | "ADMIN" (ver src/types/papel.ts). String, não enum: o provider
  // sqlite do Prisma não suporta enum nativo.
  papel     String   @default("USER")
  criadoEm  DateTime @default(now())

  capturas Captura[]
}

// Um Pokémon capturado por um usuário.
model Captura {
  id          Int      @id @default(autoincrement())
  userId      Int
  pokemonId   Int
  capturadoEm DateTime @default(now())

  usuario User    @relation(fields: [userId], references: [id])
  pokemon Pokemon @relation(fields: [pokemonId], references: [id])

  @@unique([userId, pokemonId])
}
