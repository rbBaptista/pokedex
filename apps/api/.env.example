# Copie este arquivo para .env e preencha os valores.

# Caminho do banco SQLite (relativo a este arquivo).
DATABASE_URL="file:../../prisma/dev.db"

# Segredo usado para assinar o token de login (JWT). Qualquer string longa e
# aleatória serve em dev — gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
